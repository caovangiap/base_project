<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lato font styles -->
    <style name="LatoTextBold">
        <item name="android:fontFamily">@font/lato_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontWeight">700</item>
    </style>

    <style name="LatoTextRegular">
        <item name="android:fontFamily">@font/lato_font_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">400</item>
    </style>

    <style name="LatoTextLight">
        <item name="android:fontFamily">@font/lato_font_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">300</item>
    </style>

    <style name="LatoTextItalic">
        <item name="android:fontFamily">@font/lato_font_family</item>
        <item name="android:textStyle">italic</item>
        <item name="android:fontWeight">400</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Custom style for filter buttons to override Material3 theme -->
    <style name="FilterButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="MyPopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu_rounded</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
        <item name="android:itemTextAppearance">@style/MyPopupMenuItemTextAppearance</item>
    </style>
    
    <style name="MyPopupMenuItemTextAppearance" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>


    <!-- Bottom Sheet Dialog Theme -->
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>



</resources>