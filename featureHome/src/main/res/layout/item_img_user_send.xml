<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:paddingStart="44dp"
    android:paddingEnd="16dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imagUserSend"
        android:layout_width="156dp"
        android:layout_height="208dp"
        app:layout_constraintEnd_toStartOf="@+id/imgUserAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/imgUserAvatar"
        android:background="@drawable/bg_boder_8"
        android:layout_marginEnd="4dp"
        app:shapeAppearanceOverlay="@style/Rounded8ImageView"
        android:src="@drawable/bg_meet_ai_partner"
        />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgUserAvatar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_meet_ai_partner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

</androidx.constraintlayout.widget.ConstraintLayout>

