<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_border_16"
    android:backgroundTint="@color/color_27FFFFFF"
    android:id="@+id/container"
    tools:background="@color/color_CC000000"
    tools:backgroundTint="@color/color_CC000000"
    >

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_your_story"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="16dp"
        />

    <View
        android:id="@+id/vOnlineIndicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="-2dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/shape_online_indicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/ivAvatar"
        app:layout_constraintVertical_bias="0" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/lato_bold"
        android:textColor="@color/color_FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintTop_toTopOf="@id/ivAvatar"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintVertical_bias="0"
        tools:text="Luna Brightstar"
        android:layout_marginTop="3dp"
        />


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/tvName"
        app:layout_constraintBottom_toBottomOf="@+id/tvName"
        app:layout_constraintStart_toEndOf="@+id/tvName"
        android:layout_marginStart="8dp"
        android:text="@string/lvl_1"
        android:id="@+id/tvLevel"
        android:paddingVertical="1dp"
        android:paddingHorizontal="8dp"
        android:background="@drawable/bg_border_40_stroke"
        android:textSize="12dp"
        android:textColor="@color/color_FF3374"
        android:fontFamily="@font/lato_bold"
        />



    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/lato_regular"
        android:textColor="@color/color_FFFFFF99"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvName"
        app:layout_constraintVertical_bias="0"
        tools:text="22:05" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvUnreadCount"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:text="The journey begins now!" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/tvUnreadCount"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/color_FF3374"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:layout_constraintBottom_toBottomOf="@id/tvMessage"
        app:layout_constraintTop_toTopOf="@+id/tvMessage"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/tvUnreadCount"
        app:layout_constraintBottom_toBottomOf="@+id/tvUnreadCount"
        app:layout_constraintStart_toStartOf="@+id/tvUnreadCount"
        app:layout_constraintEnd_toEndOf="@+id/tvUnreadCount"
        android:id="@+id/tvCountMessage"
        android:text="@string/_1"
        android:fontFamily="@font/lato_bold"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:layout_marginEnd="0.5dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>



