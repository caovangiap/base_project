<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_border_24_top"
    android:backgroundTint="@color/color_262626"
    android:theme="@style/Theme.AppCompat"
    android:id="@+id/container"
    >


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_over"
        android:backgroundTint="@color/color_FFFFFF1A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="@id/btnClose"
        app:layout_constraintEnd_toEndOf="@id/btnClose"
        android:padding="9dp"
        android:src="@drawable/ic_cancel"
        />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCharacterName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/lato_bold"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="@+id/tagsContainer"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Astra Nova"
        android:layout_marginVertical="16dp"
        android:maxLines="1"
        />

    <LinearLayout
        android:id="@+id/tagsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCharacterName"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTag1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_border_40"
            android:backgroundTint="@color/color_27FFFFFF"
            android:fontFamily="@font/lato_regular"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Maid" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTag2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_border_40"
            android:backgroundTint="@color/color_27FFFFFF"
            android:fontFamily="@font/lato_regular"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Aquarius" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/lato_regular"
        android:lineSpacingExtra="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tagsContainer"
        tools:text="Astra Nova is an AI with a passion for understanding humanity. She enjoys deep conversations and exploring the intricacies of human relationships."
        app:layout_constraintStart_toStartOf="@+id/tagsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        />


    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/color_transparent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="@+id/tagsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:tabMaxWidth="200dp"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/white"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="@color/color_848484"
        app:tabIndicatorFullWidth="false"
        app:tabRippleColor="@null"
        app:tabPaddingStart="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingTop="0dp"
        app:tabPaddingBottom="0dp"
        app:tabContentStart="0dp"
        app:tabGravity="fill"
        />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAvatars"
        android:layout_width="0dp"
        android:layout_height="350dp"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/tabsContainer"
        app:layout_constraintStart_toStartOf="@+id/tagsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="-8dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
