<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_border_24_top"
    android:backgroundTint="#FB2E69"
   >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >


        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="322dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/banner_level"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_boder_top_24"
            android:backgroundTint="@color/color_transparent"
            app:shapeAppearanceOverlay="@style/RoundedTopImageView"
            android:id="@+id/background"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@+id/background"
            app:layout_constraintBottom_toBottomOf="@+id/background"
            app:layout_constraintStart_toStartOf="@+id/background"
            app:layout_constraintEnd_toEndOf="@+id/background"
            android:background="@drawable/bg_shadow_pink"
            app:shapeAppearanceOverlay="@style/RoundedTopImageView"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="196dp"
            android:layout_height="196dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/heart_img"
            android:scaleType="centerCrop"
            android:id="@+id/icHeart"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvLevel"
            app:layout_constraintTop_toTopOf="@id/icHeart"
            app:layout_constraintBottom_toBottomOf="@id/icHeart"
            app:layout_constraintStart_toStartOf="@id/icHeart"
            app:layout_constraintEnd_toEndOf="@id/icHeart"
            app:layout_constraintVertical_bias="0.76"
            android:text="@string/level_1"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:fontFamily="@font/lato_bold"
            />
        
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="@id/icHeart"
            app:layout_constraintEnd_toEndOf="@id/icHeart"
            app:layout_constraintStart_toStartOf="@id/icHeart"
            app:layout_constraintBottom_toTopOf="@id/tvLevel"
            app:layout_constraintVertical_bias="1"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="29dp"
            android:weightSum="2"
            android:orientation="horizontal"
            >

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/aiAvatar"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_meet_ai_partner"
                android:layout_marginEnd="10dp"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                android:paddingVertical="3dp"
                android:paddingHorizontal="3dp"
                />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/userAvatar"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_meet_ai_partner"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:layout_marginStart="10dp"
                android:paddingVertical="3dp"
                android:paddingHorizontal="3dp"
                />



        </androidx.appcompat.widget.LinearLayoutCompat>


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@color/color_FFFFFF26"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:shapeAppearance="@style/CircleImageView"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/btnClose"
            app:layout_constraintBottom_toBottomOf="@id/btnClose"
            app:layout_constraintStart_toStartOf="@id/btnClose"
            app:layout_constraintEnd_toEndOf="@id/btnClose"
            android:padding="7dp"
            android:src="@drawable/ic_cancel"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/containerPoint"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/bg_border_16_gadient_yellow"
        android:layout_marginHorizontal="16dp"
        >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intimacy_point"
            android:fontFamily="@font/lato_bold"
            android:textSize="16sp"
            android:textColor="@color/color_AE6C64"
            android:id="@+id/titlePoint"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:id="@+id/point"
            app:layout_constraintStart_toEndOf="@+id/titlePoint"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0"
            android:text="@string/_70"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/lato_bold"
            android:textColor="@color/color_AE6C64"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/titlePoint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="16dp"
            android:id="@+id/levePoint"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="horizontal"
            tools:listitem="@layout/item_level_benefit"
            tools:itemCount="8"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_border_16_gadient_yellow"
        android:id="@+id/dailyChallenge"
        app:layout_constraintTop_toBottomOf="@+id/containerPoint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_challenge_heat"
            android:fontFamily="@font/lato_bold"
            android:textSize="16sp"
            android:textColor="@color/color_AE6C64"
            android:id="@+id/titleDailyChallenge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/titleDailyChallenge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="13dp"
            app:layout_constraintHorizontal_bias="0"
            android:layout_marginStart="12dp"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:background="@drawable/bg_over"
            android:backgroundTint="@color/color_FFD5B6"
            android:id="@+id/bgSend2Message"
            />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@+id/bgSend2Message"
            app:layout_constraintStart_toStartOf="@+id/bgSend2Message"
            app:layout_constraintEnd_toEndOf="@+id/bgSend2Message"
            app:layout_constraintBottom_toBottomOf="@+id/bgSend2Message"
            android:src="@drawable/ic_send_2_message"
            android:padding="10dp"
            android:scaleType="fitCenter"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvSend2Message"
            app:layout_constraintStart_toEndOf="@+id/bgSend2Message"
            app:layout_constraintTop_toTopOf="@id/bgSend2Message"
            app:layout_constraintBottom_toBottomOf="@id/bgSend2Message"
            android:text="@string/send_2_messages"
            app:layout_constraintVertical_bias="0"
            android:textSize="14sp"
            android:fontFamily="@font/lato_bold"
            android:textColor="@color/color_AE6C64"
            android:layout_marginStart="8dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/bgSend2Message"
            app:layout_constraintBottom_toBottomOf="@id/bgSend2Message"
            app:layout_constraintTop_toBottomOf="@id/tvSend2Message"
            android:text="@string/_1_2_complete"
            android:textColor="@color/color_AE6C64"
            android:layout_marginStart="8dp"
            android:id="@+id/completeSendDaily"
            />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loading"
            android:layout_width="0dp"
            android:layout_height="8dp"
            app:indeterminateAnimationType="disjoint"
            app:layout_constraintBottom_toBottomOf="@+id/completeSendDaily"
            app:layout_constraintStart_toEndOf="@+id/completeSendDaily"
            app:layout_constraintEnd_toStartOf="@id/itemDaily1"
            app:layout_constraintTop_toTopOf="@+id/completeSendDaily"
            android:layout_marginHorizontal="32dp"
            app:indicatorColor="#AE6C64"
            app:trackColor="#FFEBDC"
            app:trackThickness="6dp"
            app:trackCornerRadius="26dp"
            android:orientation="horizontal"
            app:indicatorDirectionLinear="startToEnd"
            android:progress="50"
            android:max="100"
            />

         <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="@drawable/bg_border_24_stroke"
             app:layout_constraintTop_toTopOf="@+id/bgSend2Message"
             app:layout_constraintBottom_toBottomOf="@+id/bgSend2Message"
             app:layout_constraintEnd_toEndOf="parent"
             android:paddingHorizontal="12dp"
             android:paddingVertical="6dp"
             android:gravity="center_vertical"
             android:layout_margin="4dp"
             android:id="@+id/itemDaily1"
             android:layout_marginEnd="20dp"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintHorizontal_bias="1"
             >

             <TextView
                 android:id="@+id/tv_bonus_value1"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/_50"
                 android:textColor="#A34A3A"
                 android:textSize="16sp"
                 android:textStyle="bold"
                 android:fontFamily="sans-serif-medium" />

             <androidx.appcompat.widget.AppCompatImageView
                 android:id="@+id/iv_heart1"
                 android:layout_width="20dp"
                 android:layout_height="20dp"
                 android:layout_marginStart="6dp"
                 android:src="@drawable/heart_img"
                 />

         </LinearLayout>


         <com.google.android.material.imageview.ShapeableImageView
             android:layout_width="40dp"
             android:layout_height="40dp"
             app:layout_constraintTop_toBottomOf="@id/bgSend2Message"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             android:layout_marginTop="10dp"
             app:layout_constraintHorizontal_bias="0"
             android:layout_marginStart="12dp"
             app:shapeAppearanceOverlay="@style/CircleImageView"
             android:background="@drawable/bg_over"
             android:backgroundTint="@color/color_FFD5B6"
             android:id="@+id/bgSend3Message"
             />

         <com.google.android.material.imageview.ShapeableImageView
             android:layout_width="0dp"
             android:layout_height="0dp"
             app:layout_constraintTop_toTopOf="@+id/bgSend3Message"
             app:layout_constraintStart_toStartOf="@+id/bgSend3Message"
             app:layout_constraintEnd_toEndOf="@+id/bgSend3Message"
             app:layout_constraintBottom_toBottomOf="@+id/bgSend3Message"
             android:src="@drawable/ic_ads_watch"
             android:padding="10dp"
             android:scaleType="fitCenter"
             />

         <androidx.appcompat.widget.AppCompatTextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:id="@+id/tvSend3Message"
             app:layout_constraintStart_toEndOf="@+id/bgSend3Message"
             app:layout_constraintTop_toTopOf="@id/bgSend3Message"
             app:layout_constraintBottom_toBottomOf="@id/bgSend3Message"
             android:text="@string/watch_ads"
             app:layout_constraintVertical_bias="0"
             android:textSize="14sp"
             android:fontFamily="@font/lato_bold"
             android:textColor="@color/color_AE6C64"
             android:layout_marginStart="8dp"
             />

         <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             app:layout_constraintStart_toEndOf="@+id/bgSend3Message"
             app:layout_constraintBottom_toBottomOf="@id/bgSend3Message"
             app:layout_constraintTop_toBottomOf="@id/tvSend3Message"
             android:text="@string/_2_10_complete"
             android:textColor="@color/color_AE6C64"
             android:layout_marginStart="8dp"
             android:id="@+id/completeSendDaily2"
             />

         <com.google.android.material.progressindicator.LinearProgressIndicator
             android:id="@+id/loading2"
             android:layout_width="0dp"
             android:layout_height="8dp"
             app:indeterminateAnimationType="disjoint"
             app:layout_constraintBottom_toBottomOf="@+id/completeSendDaily2"
             app:layout_constraintStart_toEndOf="@+id/completeSendDaily2"
             app:layout_constraintEnd_toStartOf="@id/itemDaily2"
             app:layout_constraintTop_toTopOf="@+id/completeSendDaily2"
             android:layout_marginHorizontal="32dp"
             app:indicatorColor="#AE6C64"
             app:trackColor="#FFEBDC"
             app:trackThickness="6dp"
             app:trackCornerRadius="26dp"
             android:orientation="horizontal"
             app:indicatorDirectionLinear="startToEnd"
             android:progress="66"
             android:max="100"
             />

         <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="@drawable/bg_border_24_stroke"
             app:layout_constraintTop_toTopOf="@+id/bgSend3Message"
             app:layout_constraintBottom_toBottomOf="@+id/bgSend3Message"
             app:layout_constraintEnd_toEndOf="parent"
             android:paddingHorizontal="12dp"
             android:paddingVertical="6dp"
             android:gravity="center_vertical"
             android:layout_margin="4dp"
             android:id="@+id/itemDaily2"
             android:layout_marginEnd="20dp"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintHorizontal_bias="1"
             >

             <TextView
                 android:id="@+id/tv_bonus_value2"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/_50"
                 android:textColor="#A34A3A"
                 android:textSize="16sp"
                 android:textStyle="bold"
                 android:fontFamily="sans-serif-medium" />

             <ImageView
                 android:id="@+id/iv_heart2"
                 android:layout_width="20dp"
                 android:layout_height="20dp"
                 android:layout_marginStart="6dp"
                 android:src="@drawable/heart_img"
                 />

         </LinearLayout>


         <com.google.android.material.imageview.ShapeableImageView
             android:layout_width="40dp"
             android:layout_height="40dp"
             app:layout_constraintTop_toBottomOf="@id/bgSend3Message"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintEnd_toEndOf="parent"
             android:layout_marginTop="10dp"
             app:layout_constraintHorizontal_bias="0"
             android:layout_marginStart="12dp"
             app:shapeAppearanceOverlay="@style/CircleImageView"
             android:background="@drawable/bg_over"
             android:backgroundTint="@color/color_FFD5B6"
             android:id="@+id/bgSend5Message"
             android:layout_marginBottom="17dp"
             app:layout_constraintBottom_toBottomOf="parent"
             />

         <com.google.android.material.imageview.ShapeableImageView
             android:layout_width="0dp"
             android:layout_height="0dp"
             app:layout_constraintTop_toTopOf="@+id/bgSend5Message"
             app:layout_constraintStart_toStartOf="@+id/bgSend5Message"
             app:layout_constraintEnd_toEndOf="@+id/bgSend5Message"
             app:layout_constraintBottom_toBottomOf="@+id/bgSend5Message"
             android:src="@drawable/ic_notification"
             android:padding="10dp"
             android:scaleType="fitCenter"
             />

         <androidx.appcompat.widget.AppCompatTextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:id="@+id/tvSend5Message"
             app:layout_constraintStart_toEndOf="@+id/bgSend5Message"
             app:layout_constraintTop_toTopOf="@id/bgSend5Message"
             app:layout_constraintBottom_toBottomOf="@id/bgSend5Message"
             android:text="@string/turn_on_notifications"
             android:textSize="14sp"
             android:fontFamily="@font/lato_bold"
             android:textColor="@color/color_AE6C64"
             android:layout_marginStart="8dp"
             />


         <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:background="@drawable/bg_border_24_stroke"
             app:layout_constraintTop_toTopOf="@+id/bgSend5Message"
             app:layout_constraintBottom_toBottomOf="@+id/bgSend5Message"
             app:layout_constraintEnd_toEndOf="parent"
             android:paddingHorizontal="12dp"
             android:paddingVertical="6dp"
             android:gravity="center_vertical"
             android:layout_margin="4dp"
             android:id="@+id/itemDaily3"
             android:layout_marginEnd="20dp"
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintHorizontal_bias="1"
             >

             <TextView
                 android:id="@+id/tv_bonus_value3"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/_50"
                 android:textColor="#A34A3A"
                 android:textSize="16sp"
                 android:textStyle="bold"
                 android:fontFamily="sans-serif-medium" />

             <ImageView
                 android:id="@+id/iv_heart3"
                 android:layout_width="20dp"
                 android:layout_height="20dp"
                 android:layout_marginStart="6dp"
                 android:src="@drawable/heart_img"
                 />

         </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
